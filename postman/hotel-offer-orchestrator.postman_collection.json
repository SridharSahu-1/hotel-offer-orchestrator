{
  "info": {
    "name": "Hotel Offer Orchestrator",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "baseUrl", "value": "http://localhost:3000" }],
  "item": [
    { "name": "Health", "request": { "method": "GET", "url": "{{baseUrl}}/health" } },
    { "name": "Supplier A", "request": { "method": "GET", "url": "{{baseUrl}}/supplierA/hotels?city=delhi" } },
    { "name": "Supplier B", "request": { "method": "GET", "url": "{{baseUrl}}/supplierB/hotels?city=delhi" } },
    { "name": "All Delhi Hotels", "request": { "method": "GET", "url": "{{baseUrl}}/api/hotels?city=delhi" } },
    { "name": "Filtered Delhi Hotels", "request": { "method": "GET", "url": "{{baseUrl}}/api/hotels?city=delhi&minPrice=5000&maxPrice=6000" } },
    { "name": "No Results", "request": { "method": "GET", "url": "{{baseUrl}}/api/hotels?city=mumbai" } }
  ]
}
